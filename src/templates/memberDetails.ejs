
<!DOCTYPE html>

<html lang="en" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">
  <head>
    <title></title>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
      }

      a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: inherit !important;
      }

      #MessageViewBody a {
        color: inherit;
        text-decoration: none;
      }

      p {
        line-height: inherit;
      }

      .desktop_hide,
      .desktop_hide table {
        mso-hide: all;
        display: none;
        max-height: 0px;
        overflow: hidden;
      }

      .image_block img + div {
        display: none;
      }

      @media (max-width: 670px) {
        .desktop_hide table.icons-inner,
        .row-1 .column-1 .block-1.image_block img {
          display: inline-block !important;
        }

        .icons-inner {
          text-align: center;
        }

        .icons-inner td {
          margin: 0 auto;
        }

        .mobile_hide {
          display: none;
        }

        .row-content {
          width: 100% !important;
        }

        .stack .column {
          width: 100%;
          display: block;
        }

        .mobile_hide {
          min-height: 0;
          max-height: 0;
          max-width: 0;
          overflow: hidden;
          font-size: 0px;
        }

        .desktop_hide,
        .desktop_hide table {
          display: table !important;
          max-height: none !important;
        }

        .row-1 .column-1 .block-1.image_block .alignment {
          text-align: center !important;
        }
      }
    </style>
  </head>

  <body
    style="background-color: #f6f6f6; margin: 0; padding: 0; -webkit-text-size-adjust: none; text-size-adjust: none"
  >
    <table
      border="0"
      cellpadding="0"
      cellspacing="0"
      class="nl-container"
      role="presentation"
      style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #f7f9ff; margin-top: 50px"
      width="100%"
    >
      <tbody>
        <tr>
          <td>
            <table
              align="center"
              border="0"
              cellpadding="0"
              cellspacing="0"
              class="row row-1"
              role="presentation"
              style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #f6f6f6"
              width="100%"
            >
              <tbody>
                <tr>
                  <td>
                    <table
                      align="center"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      class="row-content stack"
                      role="presentation"
                      style="
                        mso-table-lspace: 0pt;
                        mso-table-rspace: 0pt;
                        background-color: #fff;
                        color: #000;
                        width: 650px;
                        margin: 0 auto;
                      "
                      width="650"
                    >
                      <tbody>
                        <td
                          class="pad"
                          style="
                            padding-bottom: 16px;
                            padding-left: 25px;
                            padding-right: 25px;
                            padding-top: 16px;
                            width: 100%;
                          "
                        >
                          <div align="center" class="alignment" style="line-height: 10px">
                            <a href="http://example.com" style="outline: none" tabindex="-1" target="_blank"
                              ></a>
                          </div>
                        </td>
                      </tbody>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td>
                    <table
                      align="center"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      class="row-content stack"
                      role="presentation"
                      style="
                        mso-table-lspace: 0pt;
                        mso-table-rspace: 0pt;
                        background-color: #486a1d;
                        color: #000;
                        width: 650px;
                        margin: 0 auto;
                      "
                      width="650"
                    >
                      <tbody>
                        <td
                          class="pad"
                          style="
                            padding-bottom: 30px;
                            padding-left: 25px;
                            padding-right: 25px;
                            padding-top: 30px;
                            width: 100%;
                          "
                        >
                          <div align="center" class="alignment" style="line-height: 10px">
                           
                            <h4
                              style="
                                font-family: 'Poppins', sans-serif;
                                font-size: 22px;
                                font-weight: 500;
                                text-align: center;
                                color: #fff;
                                margin: 20px 0px 0px;
                              "
                            >
                              Welcome Abroad !!
                            </h4>
                          </div>
                        </td>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
            <table
              align="center"
              border="0"
              cellpadding="0"
              cellspacing="0"
              class="row row-2"
              role="presentation"
              style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #f6f6f6"
              width="100%"
            >
              <tbody>
                <tr>
                  <td>
                    <table
                      align="center"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      class="row-content stack"
                      role="presentation"
                      style="
                        mso-table-lspace: 0pt;
                        mso-table-rspace: 0pt;
                        background-color: #fff;
                        color: #000;
                        border-radius: 0;
                        width: 650px;
                        margin: 0 auto;
                      "
                      width="650"
                    >
                      <tbody>
                        <td class="pad" style="padding: 20px 25px">
                          <div
                            style="
                              color: #000;
                              direction: ltr;
                              font-family: 'Poppins', sans-serif;
                              font-size: 16px;
                              font-weight: 400;
                              letter-spacing: 0px;
                              line-height: 1.4;
                              text-align: left;
                              padding: 15px 0px 40px;
                            "
                          >
                            <p style="margin: 0; color: #000; margin-bottom: 16px; font-size: 18px; line-height: 1.4">
                              <strong>Hello <%= memberDetail.username %></p></strong>
                            </p>
                            <p style="margin: 0; color: #000; margin-bottom: 16px; line-height: 1.4">Dear User,</p>
                           <p style="color: #000;"> Welcome to our shop , we will highly appricitate your work</p>
                            
                            <p style="margin: 0; color: #000; line-height: 1.4">You can Now Simply with your username / email and password </p>

                            <p style="color: #000;">Username: <%= memberDetail.username %></p>
                            <p style="color: #000;">Password: <%= memberDetail.password %></p>
                           
                            <p style="color: #000;">Your Role: <%= memberDetail.RoleName %></p>

                          </div>
                        
                          <div
                            style="
                              color: #626262;
                              direction: ltr;
                              font-family: 'Poppins', sans-serif;
                              font-size: 14px;
                              font-weight: 400;
                              letter-spacing: 0px;
                              line-height: 1.4;
                              text-align: left;
                              padding: 20px 0px 10px;
                            "
                          >
                            <p style="margin: 0; margin-bottom: 16px; color: #626262;">
                              Thanks
                            </p>
                          </div>
                        </td>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>

         
          </td>
        </tr>
      </tbody>
    </table>
    <!-- End -->
  </body>
</html>
