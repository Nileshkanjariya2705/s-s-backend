  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
    "lint": "tslint -c tslint.json -p tsconfig.json --fix",
    "migration": "npx sequelize  db:migrate",
    "seeder": "npx sequelize db:seed:all",
    "undo-migration": "npx sequelize db:migrate:undo:all",
    "build": "tsc && cp -r src/templates dist && tsc-alias",
    "start": "export NODE_ENV=development && node dist/server.js",
    "production": "cross-env NODE_ENV=development nodemon --watch 'src/**/*.ts' --exec 'ts-node' -r tsconfig-paths/register --transpile-only src/server.ts"
  },
